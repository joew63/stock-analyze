# Finnhub — free tier: https://finnhub.io/register
# Used for: quote, analyst recommendation trend, company news, earnings surprises
FINNHUB_API_KEY=

# Financial Modeling Prep — free tier: https://site.financialmodelingprep.com/register
# Used for: company profile, financial ratios/key metrics, income statement history, historical daily prices
FMP_API_KEY=

# Daily stock digest email (see README "Daily stock digest" section for setup)
# Sender/recipient must be verified SES identities. No AWS access keys here —
# sending relies on the Amplify SSR compute role's IAM permissions.
DIGEST_SENDER_EMAIL=
DIGEST_RECIPIENT_EMAIL=
DIGEST_AWS_REGION=us-east-1
# Shared secret the EventBridge Scheduler must send as the x-digest-secret
# header. Generate with: openssl rand -hex 32
DIGEST_CRON_SECRET=

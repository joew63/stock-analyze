# Copy to .env.local and fill in. These are also the five GitHub Actions
# repository secrets the digest workflows expect.

# Free-tier data provider keys (no credit card required)
FINNHUB_API_KEY=
FMP_API_KEY=

# Gmail sending. DIGEST_GMAIL_APP_PASSWORD is a 16-char App Password
# (Google Account -> Security -> App passwords), not your account password.
DIGEST_GMAIL_USER=
DIGEST_GMAIL_APP_PASSWORD=
DIGEST_RECIPIENT_EMAIL=
